{% from "palette.jinja" import palettes %}
{% from "card.jinja" import font, brand_rim_colors, rim_gradient, card_fill, card_border %}
{% set palette = palettes[theme] %}
{% set cell_size = 10 %}
{% set cell_step = 13 %}
{% set padding = 22 %}
{% set grid_left = 50 %}
{% set grid_top = 84 %}
{% set width = grid_left + weeks * cell_step - (cell_step - cell_size) + padding + 18 %}
{% set height = grid_top + days_per_week * cell_step - (cell_step - cell_size) + 44 %}
{% set legend_left = width - padding - 28 - palette.heatmap_levels|length * cell_step %}
<svg xmlns="http://www.w3.org/2000/svg" width="{{ width }}" height="{{ height }}" viewBox="0 0 {{ width }} {{ height }}" role="img" aria-label="{{ description }}">
  <title>{{ description }}</title>
  <defs>
{{ rim_gradient(brand_rim_colors, 1) }}
{% for glow, color, center_x, center_y, radius in (("cyan", "#22d3ee", 0.1, 0, 0.6), ("violet", "#8b5cf6", 0.95, 0.3, 0.55), ("pink", "#e879f9", 0.45, 1.1, 0.6)) %}
    <radialGradient id="{{ glow }}" cx="{{ center_x }}" cy="{{ center_y }}" r="{{ radius }}">
      <stop offset="0" stop-color="{{ color }}" stop-opacity="{{ palette.heatmap_glow_opacity }}"/>
      <stop offset="1" stop-color="{{ color }}" stop-opacity="0"/>
    </radialGradient>
{% endfor %}
  </defs>
{{ card_fill(width, height, palette.background) }}
{% for glow in ("cyan", "violet", "pink") %}
{{ card_fill(width, height, "url(#" ~ glow ~ ")") }}
{% endfor %}
{{ card_border(width, height) }}
  <text x="{{ padding }}" y="{{ padding + 18 }}" fill="{{ palette.ink }}" font-family="{{ font }}" font-size="18" font-weight="700" letter-spacing="-0.3">{{ name }}</text>
  <text x="{{ padding }}" y="{{ padding + 38 }}" fill="{{ palette.ink }}" fill-opacity="0.6" font-family="{{ font }}" font-size="11">{{ caption }}</text>
  <text x="{{ width - padding }}" y="{{ padding + 22 }}" text-anchor="end" fill="{{ palette.rarities.epic[0] }}" font-family="{{ font }}" font-size="24" font-weight="700" letter-spacing="-0.4">{{ total_tokens | compact_tokens }}</text>
  <g font-family="{{ font }}" font-size="9.5" fill="{{ palette.ink }}" fill-opacity="0.6">
{% for label in month_labels %}
    <text x="{{ grid_left + label.week * cell_step }}" y="{{ grid_top - 7 }}">{{ label.name }}</text>
{% endfor %}
{% for weekday, name in ((1, "Mon"), (3, "Wed"), (5, "Fri")) %}
    <text x="{{ grid_left - 8 }}" y="{{ grid_top + weekday * cell_step + cell_size / 2 + 3.5 }}" text-anchor="end">{{ name }}</text>
{% endfor %}
    <text x="{{ grid_left }}" y="{{ height - 14 }}">GitToken</text>
    <text x="{{ legend_left - 6 }}" y="{{ height - 14 }}" text-anchor="end">Less</text>
    <text x="{{ width - padding - 24 }}" y="{{ height - 14 }}">More</text>
  </g>
  <g stroke="{{ palette.ink }}" stroke-opacity="0.06">
{% for cell_day in cells %}
{% set color, opacity = palette.heatmap_levels[cell_day.level] %}
    <rect x="{{ grid_left + cell_day.week * cell_step }}" y="{{ grid_top + cell_day.weekday * cell_step }}" width="{{ cell_size }}" height="{{ cell_size }}" rx="3" fill="{{ color }}" fill-opacity="{{ opacity }}"/>
{% endfor %}
{% for color, opacity in palette.heatmap_levels %}
    <rect x="{{ legend_left + loop.index0 * cell_step }}" y="{{ height - 23 }}" width="{{ cell_size }}" height="{{ cell_size }}" rx="3" fill="{{ color }}" fill-opacity="{{ opacity }}"/>
{% endfor %}
  </g>
</svg>

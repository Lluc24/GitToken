{% from "palette.jinja" import palettes, brand_rim_colors %}
{% from "card.jinja" import font, rim_gradient, card_fill, card_border %}
{% set palette = palettes[theme] %}
{% set width = 360 %}
{% set height = 96 %}
<svg xmlns="http://www.w3.org/2000/svg" width="{{ width }}" height="{{ height }}" viewBox="0 0 {{ width }} {{ height }}" role="img" aria-label="{{ description }}">
  <title>{{ description }}</title>
  <style>
    .dot { animation: pulse 1.2s ease-in-out infinite; }
    .dot:nth-of-type(2) { animation-delay: 0.2s; }
    .dot:nth-of-type(3) { animation-delay: 0.4s; }
    @keyframes pulse { 0%, 100% { opacity: 0.25; } 50% { opacity: 1; } }
    @media (prefers-reduced-motion: reduce) { .dot { animation: none; opacity: 0.6; } }
  </style>
  <defs>
{{ rim_gradient(brand_rim_colors, 0.5) }}
  </defs>
{{ card_fill(width, height, palette.background) }}
{{ card_border(width, height) }}
  <text x="24" y="42" fill="{{ palette.ink }}" font-family="{{ font }}" font-size="20" font-weight="700" letter-spacing="-0.3">{{ name }}</text>
  <text x="24" y="66" fill="{{ palette.ink }}" fill-opacity="0.62" font-family="{{ font }}" font-size="12.5">{{ message }}</text>
{% if is_pending %}
  <g fill="{{ brand_rim_colors[1] }}">
    <circle class="dot" cx="300" cy="48" r="5"/>
    <circle class="dot" cx="316" cy="48" r="5"/>
    <circle class="dot" cx="332" cy="48" r="5"/>
  </g>
{% endif %}
</svg>

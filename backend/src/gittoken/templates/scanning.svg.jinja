{% from "palette.jinja" import palettes %}
{% set palette = palettes[theme] %}
{% set width = 360 %}
{% set height = 96 %}
{% set font = "-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', system-ui, sans-serif" %}
{% set name = login if login|length <= 20 else login[:19] ~ "…" %}
{% set description = "Scanning " ~ login ~ "'s public commits" %}
<svg xmlns="http://www.w3.org/2000/svg" width="{{ width }}" height="{{ height }}" viewBox="0 0 {{ width }} {{ height }}" role="img" aria-label="{{ description }}">
  <title>{{ description }}</title>
  <style>
    .dot { animation: pulse 1.2s ease-in-out infinite; }
    .dot:nth-of-type(2) { animation-delay: 0.2s; }
    .dot:nth-of-type(3) { animation-delay: 0.4s; }
    @keyframes pulse { 0%, 100% { opacity: 0.25; } 50% { opacity: 1; } }
    @media (prefers-reduced-motion: reduce) { .dot { animation: none; opacity: 0.6; } }
  </style>
  <defs>
    <linearGradient id="rim" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#67e8f9"/>
      <stop offset="0.5" stop-color="#a78bfa" stop-opacity="0.5"/>
      <stop offset="1" stop-color="#f0abfc"/>
    </linearGradient>
  </defs>
  <rect width="{{ width }}" height="{{ height }}" rx="24" fill="{{ palette.background }}"/>
  <rect x="1" y="1" width="{{ width - 2 }}" height="{{ height - 2 }}" rx="23" fill="none" stroke="url(#rim)" stroke-width="2"/>
  <text x="24" y="42" fill="{{ palette.ink }}" font-family="{{ font }}" font-size="20" font-weight="700" letter-spacing="-0.3">{{ name }}</text>
  <text x="24" y="66" fill="{{ palette.ink }}" fill-opacity="0.62" font-family="{{ font }}" font-size="12.5">Scanning public commits, back in a minute</text>
  <g fill="#a78bfa">
    <circle class="dot" cx="300" cy="48" r="5"/>
    <circle class="dot" cx="316" cy="48" r="5"/>
    <circle class="dot" cx="332" cy="48" r="5"/>
  </g>
</svg>

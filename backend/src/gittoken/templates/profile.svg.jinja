{% from "profile_card.jinja" import profile_card, panel_height with context %}
{% set width = 300 %}
{% set inset = 12 %}
{% set photo_size = width - 2 * inset %}
{% set panel_top = inset + photo_size + 68 %}
{% set label_top = panel_top + panel_height + (24 if rows else 18) %}
{{ profile_card(
  width=width,
  height=label_top + 16,
  photo_x=inset,
  photo_y=inset,
  photo_size=photo_size,
  text_x=inset + 10,
  name_y=inset + photo_size + 34,
  rarity_y=inset + photo_size + 54,
  total_x=width - inset - 10,
  total_y=inset + photo_size + 50,
  panel_x=inset,
  panel_y=panel_top,
  panel_width=photo_size,
  label_x=width / 2,
  label_y=label_top,
) }}
